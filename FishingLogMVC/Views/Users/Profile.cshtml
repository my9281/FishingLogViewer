@model FishingLogMVC.Models.ProfileViewModel

<div class="login user-regist-box">
        <h2>@ViewBag.Dic["ProfileTitle"]</h2>
        <div class="login-box">
                <div class="login-template">
                        <div class="login-inner">
                                <div>
                                        <span>@ViewBag.Dic["AccountID"]</span>
                                </div>
                                <input type="text" id="pid" value="@Model.Username" readonly>
                                <div>
                                        <span>@ViewBag.Dic["Nickname"]</span>
                                </div>
                                <input type="text" id="pnick" value="@Model.Nickname" placeholder="@ViewBag.Dic["NicknamePH"]">
                                <div>
                                        <span>@ViewBag.Dic["Location"]</span>
                                </div>
                                <input type="text" id="ploc" value="@Model.Location" placeholder="@ViewBag.Dic["LocationPH"]">
                                <div>
                                        <span>@ViewBag.Dic["Birthday"]</span>
                                </div>
                                <input type="date" id="pbirth" value="@Model.Birthday">
                        </div>
                        <div class="btn">
                                <button class="login_btn" id="profile-btn" data-success="@ViewBag.Dic["ProfileSaved"]" data-fail="@ViewBag.Dic["ProfileSaveFailed"]">
                                        @ViewBag.Dic["Save"]
                                </button>
                        </div>
                </div>
        </div>
</div>

<script type="text/javascript" src="~/js/users/profile.js"></script>
